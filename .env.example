# === WeCom / 企业微信 ===
WECOM_CORP_ID=your_corp_id
WECOM_AGENT_ID=1000001
WECOM_SECRET=your_app_secret
WECOM_TOKEN=your_callback_token
WECOM_ENCODING_AES_KEY=your_43_char_aes_key

# === LLM 接口（也可以点界面「设置」填；支持任意 OpenAI 兼容端点）===
# 三项都留空即回落到下面的 DEEPSEEK_* 配置，老配置不用改
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# === DeepSeek API（旧字段，仍兼容）===
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# === Qdrant ===
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=knowledge_base

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === Gateway ===
GATEWAY_PORT=8000
LOG_LEVEL=INFO

# === 微信客服 API 模式（channel=wecom_api 时才用）===
# 后台位置：企业微信管理后台 → 应用管理 → 微信客服
WECOM_KF_SECRET=
WECOM_OPEN_KFID=

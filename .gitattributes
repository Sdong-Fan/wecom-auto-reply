# 换行符策略：BAT 必须是 CRLF，否则 CMD 里中文会乱码（踩过）
*.bat text eol=crlf
*.cmd text eol=crlf

# 其它文本统一 LF
*.py  text eol=lf
*.md  text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf

# 二进制（别当文本处理/别做行尾转换）
*.png binary
*.jpg binary
*.ico binary
*.exe binary
*.dll binary
*.pyd binary
*.onnx binary
*.safetensors binary
*.sqlite binary
*.zip binary

